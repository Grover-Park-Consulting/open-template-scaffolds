# Access databases are extraction sources, never deliverables
*.accdb
*.mdb
*.laccdb

# Packaging artifacts
*.zip
*.7z

# Python
__pycache__/
*.pyc

# Per-machine AI-workspace config (not part of the library)
.claude/

# Per-machine editor config (not part of the library)
.vscode/

# Accumulated build records are per-developer history, not library content —
# keep the folder and its README, ignore everything that fills it
build-records/*/
